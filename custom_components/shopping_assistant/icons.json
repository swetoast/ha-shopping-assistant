{
  "entity": {
    "sensor": {
      "statistics": { "default": "mdi:barcode-scan" },
      "unknown_products": { "default": "mdi:help-circle-outline" },
      "shopping_list": { "default": "mdi:cart-outline" },
      "expiring_soon": { "default": "mdi:calendar-alert" }
    },
    "binary_sensor": {
      "api_problem": { "default": "mdi:cloud-check-outline", "state": { "on": "mdi:cloud-alert-outline" } }
    }
  },
  "services": {
    "add_mapping": { "service": "mdi:barcode" },
    "add_last_missing_mapping": { "service": "mdi:barcode-off" },
    "remove_mapping": { "service": "mdi:delete-outline" },
    "lookup_product": { "service": "mdi:magnify" },
    "add_scanned_to_shopping_list": { "service": "mdi:cart-plus" },
    "list_unknowns": { "service": "mdi:help-circle-outline" },
    "export_mappings": { "service": "mdi:database-export-outline" },
    "import_mappings": { "service": "mdi:database-import-outline" },
    "add_price": { "service": "mdi:cash-plus" },
    "set_expiry": { "service": "mdi:calendar-clock" },
    "remove_from_shopping_list": { "service": "mdi:cart-remove" },
    "update_shopping_list_quantity": { "service": "mdi:counter" },
    "clear_shopping_list": { "service": "mdi:cart-off" },
    "get_shopping_list": { "service": "mdi:cart-outline" },
    "update_product": { "service": "mdi:pencil-outline" },
    "submit_to_openfoodfacts": { "service": "mdi:cloud-upload-outline" },
    "upload_image_to_openfoodfacts": { "service": "mdi:camera-outline" }
  }
}
